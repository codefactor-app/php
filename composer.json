{
  "name": "codefactor/codefactor",
  "description": "Codefactor CLI for Composer projects, with an optional PHP API",
  "type": "composer-plugin",
  "license": "MIT",
  "require": {"php": ">=8.1", "ext-json": "*", "ext-openssl": "*", "composer-plugin-api": "^2.0"},
  "autoload": {"psr-4": {"Codefactor\\": "src/"}},
  "bin": ["bin/codefactor"],
  "extra": {"class": "Codefactor\\ComposerPlugin"},
  "scripts": {"test": ["php tests/integration.php", "php tests/cli.php"]}
}
